# =============================================================================
# Plantilla de variables de entorno.
# -----------------------------------------------------------------------------
# Copia este archivo a ".env" y ajusta los valores:
#     cp .env.example .env
#
# El archivo ".env" NO se sube al repositorio (está en .gitignore) porque
# contiene secretos. Este ".env.example" sí se sube, para documentar qué
# variables hacen falta.
# =============================================================================

# --- Base de datos ---
# SQLite para desarrollo/demo (archivo local, sin instalar nada).
DATABASE_URL=sqlite:///./resenalibros.db
#
# Para migrar a PostgreSQL en producción, basta con cambiar esta única línea,
# sin tocar el código. Ejemplo:
# DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/resenalibros

# --- Seguridad / JWT (se usa a fondo en la Fase 3) ---
# Clave para firmar los tokens. En producción debe ser larga y secreta.
# Puedes generar una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-secreta
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Aplicación ---
PROJECT_NAME=API Reseñas de Libros y Películas
DEBUG=true
